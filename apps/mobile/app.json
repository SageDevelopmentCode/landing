{
  "expo": {
    "name": "sagefield-mobile",
    "slug": "sage-field",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon.png",
    "scheme": "sagefieldmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "co.sagefield.mobile",
      "icon": "./assets/images/AppIcon.png",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.sagefield.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F5EFE8",
        "foregroundImage": "./assets/images/AppIcon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "resizeMode": "contain",
          "image": "./assets/images/Logo.png",
          "imageWidth": 120,
          "ios": {
            "backgroundColor": "#000000",
            "image": "./assets/images/Logo.png",
            "resizeMode": "contain"
          },
          "android": {
            "backgroundColor": "#000000",
            "image": "./assets/images/Logo.png",
            "imageWidth": 120,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sagefield to attach photos to messages."
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/AppIcon.png",
          "color": "#208AEF",
          "defaultChannel": "messages"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "sage-field",
          "project": "sage-field"
        }
      ],
      ["@stripe/stripe-react-native", {}]
    ],
    "extra": {
      "eas": {
        "projectId": "a1d3ec63-a7cf-422e-8a9a-dd54a49a7f5f"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a1d3ec63-a7cf-422e-8a9a-dd54a49a7f5f"
    }
  }
}
