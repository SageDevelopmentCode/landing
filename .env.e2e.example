# E2E tests use LOCAL Supabase only — never production keys.
#
# You do NOT need to copy production keys from the dashboard or .env.local.
# Run `npm run db:start` then `npm run test:e2e` — keys are loaded automatically
# from `supabase status` via scripts/load-local-supabase-env.sh.
#
# Optional manual override (local Docker only):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from supabase status: ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<from supabase status: SECRET_KEY>

# Stripe test placeholder (no real charges in v1)
STRIPE_SECRET_KEY=sk_test_e2e_placeholder

PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
